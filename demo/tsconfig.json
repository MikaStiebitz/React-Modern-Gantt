{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "lib": ["dom", "es6"],
        "strict": true,
        "noUnusedLocals": true,
        "moduleResolution": "Node",
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "react-modern-gantt": ["../src/index.ts"],
            "react-modern-gantt/dist/index.css": ["../src/styles/gantt.css"]
        }
    },
    "include": ["src"]
}

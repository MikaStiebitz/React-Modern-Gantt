{
    "name": "react-modern-gantt",
    "version": "0.9.0",
    "description": "A modern, customizable Gantt chart component for React applications with export functionality",
    "main": "dist/index.cjs",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rollup -c",
        "dev": "rollup -c -w",
        "start": "npm run dev & npm run start:demo",
        "start:demo": "cd demo && npm run dev",
        "build:demo": "cd demo && npm run build",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [
        "react",
        "gantt",
        "chart",
        "timeline",
        "project-management",
        "scheduler",
        "planning",
        "roadmap",
        "export",
        "pdf",
        "image"
    ],
    "author": "Mika Stiebitz",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/MikaStiebitz/React-Modern-Gantt/"
    },
    "peerDependencies": {
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "typescript": "^4.0.0 || ^5.0.0 || ^6.0.0"
    },
    "peerDependenciesMeta": {
        "html2canvas": {
            "optional": true
        },
        "jspdf": {
            "optional": true
        }
    },
    "optionalDependencies": {
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.1",
        "@rollup/pluginutils": "^5.5.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "autoprefixer": "^10.6.2",
        "baseline-browser-mapping": "^2.11.37",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "minimatch": "^11.0.8",
        "postcss": "^8.5.33",
        "prettier": "^3.10.1",
        "rollup": "^4.68.4",
        "rollup-plugin-dts": "^6.5.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-postcss": "^4.0.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tslib": "^2.9.1",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "date-fns": "^4.4.0"
    },
    "overrides": {
        "@testing-library/react": {
            "react": "^19.0.0",
            "react-dom": "^19.0.0"
        },
        "glob": {
            ".": "^14.0.6",
            "minimatch": "^11.0.8"
        },
        "test-exclude": {
            "minimatch": "^11.0.8"
        },
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.8"
        }
    },
    "sideEffects": [
        "*.css",
        "./styles/gantt.css"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.esm.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./dist/index.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "*": [
                "dist/index.d.ts"
            ]
        }
    }
}
